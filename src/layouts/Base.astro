---
import { site } from "../site";
import Background from "../components/Background.astro";

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: site.name,
  url: site.url,
  image: ogImage,
  sameAs: [...site.socials, ...site.streaming].map((l) => l.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.name} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Background />
    <main>
      <h1 class="name">{site.name}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --fg: #fff;
    --bg: #000;
    --overlay: transparent;
    --font-sans: "Helvetica Neue", Helvetica, Arial, system-ui, sans-serif;
    --gutter: 16px;
    --caps-tracking: 0.06em;
    color-scheme: dark;
  }
  *,
  :before,
  :after {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
  }
  body {
    margin: 0;
    min-height: 100svh;
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  img,
  video {
    max-width: 100%;
    display: block;
  }
  .visually-hidden {
    clip: rect(0 0 0 0);
    white-space: nowrap;
    width: 1px;
    height: 1px;
    position: absolute;
    overflow: hidden;
  }
  .caps-label {
    text-transform: uppercase;
    letter-spacing: var(--caps-tracking);
  }
  :focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  main {
    width: 100%;
    max-width: 440px;
    min-height: 100svh;
    margin: 0 auto;
    padding: 56px var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 32px;
    text-align: center;
  }
  .name {
    margin: 0;
    font-weight: 700;
    font-size: clamp(3.5rem, 18vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .section-title {
    margin: 0 0 10px;
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.8;
  }
  .buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .button {
    display: block;
    width: 100%;
    padding: 15px 16px;
    border: 1px solid var(--fg);
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: var(--caps-tracking);
    text-decoration: none;
    border-radius: 0;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .button.primary,
  .button:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .button:disabled {
    opacity: 0.5;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  main > * {
    animation: 1.6s both fade-in;
  }
  main > :nth-child(1) {
    animation-delay: 0.2s;
  }
  main > :nth-child(2) {
    animation-delay: 0.4s;
  }
  main > :nth-child(3) {
    animation-delay: 0.55s;
  }
  main > :nth-child(4) {
    animation-delay: 0.7s;
  }
  main > :nth-child(n + 5) {
    animation-delay: 0.85s;
  }
  @media (prefers-reduced-motion: reduce) {
    main > * {
      animation: none;
    }
  }
</style>
