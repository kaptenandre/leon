---
import { site } from "../site";

const r = site.release;
const isOut = Date.now() >= Date.parse(r.outAt);
const cta = r.smartLink ?? r.platforms[0]?.href;
---

<section aria-label={r.title} data-release data-out-at={r.outAt}>
  <ul class="buttons">
    {
      cta && (
        <li>
          <a class="button primary" href={cta} target="_blank" rel="noopener" data-cta>
            {isOut ? "Listen now" : "Pre-save"}
          </a>
        </li>
      )
    }
    {
      r.video && (
        <li>
          <a class="button" href={r.video} target="_blank" rel="noopener">
            Watch video
          </a>
        </li>
      )
    }
  </ul>
</section>

<script>
  // Flip "Pre-save" to "Listen now" at release time without a rebuild.
  document.querySelectorAll<HTMLElement>("[data-release]").forEach((el) => {
    const outAt = Date.parse(el.dataset.outAt!);
    const cta = el.querySelector<HTMLElement>("[data-cta]");
    const update = () => {
      const out = Date.now() >= outAt;
      if (cta) cta.textContent = out ? "Listen now" : "Pre-save";
      return out;
    };
    const wait = outAt - Date.now();
    if (!update() && wait < 2 ** 31 - 1) setTimeout(update, wait + 500);
  });
</script>
