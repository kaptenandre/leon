---
import type { Link } from "../site";

interface Props {
  title: string;
  links: Link[];
}

const { title, links } = Astro.props;
---

<section aria-label={title}>
  <h2 class="caps-label section-title">{title}</h2>
  <ul class="buttons">
    {
      links.map((l) => (
        <li>
          <a
            class="button"
            href={l.href}
            {...(l.href.startsWith("http") ? { target: "_blank", rel: "me noopener" } : {})}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
