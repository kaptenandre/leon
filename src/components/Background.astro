---
import { site } from "../site";

const { image, video } = site.background;
---

<div class="bg" aria-hidden="true">
  {
    video ? (
      <video
        class="bg-media"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={video.poster ?? image}
        data-bg-video
        data-src={video.mp4}
        data-mobile-src={video.mobile}
      />
    ) : (
      image && <img class="bg-media" src={image} alt="" decoding="async" fetchpriority="high" />
    )
  }
  {
    video && (
      <script is:inline>
        // Runs while the page is parsed, before the video starts loading, so phones
        // get the mobile file from the start instead of swapping mid-load.
        (function () {
          var v = document.querySelector("[data-bg-video]");
          var mobile = v.dataset.mobileSrc && matchMedia("(max-width: 700px)").matches;
          v.src = mobile ? v.dataset.mobileSrc : v.dataset.src;
        })();
      </script>
    )
  }
  <div class="bg-overlay"></div>
  <div class="grain"></div>
</div>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-bg-video]");
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (video && (matchMedia("(prefers-reduced-motion: reduce)").matches || saveData)) {
    video.removeAttribute("autoplay");
    video.pause();
  }
</script>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--bg);
    /* Keep video + grain strictly black and white. */
    filter: grayscale(1);
  }
  .bg-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
  }
  /* 16mm-style grain: a noise tile jumped around at ~12fps. */
  .grain {
    position: absolute;
    inset: -50%;
    background: url("/grain.webp") repeat;
    background-size: 240px;
    mix-blend-mode: overlay;
    opacity: 0.85;
    animation: grain 0.66s steps(8) infinite;
    pointer-events: none;
  }
  @keyframes grain {
    0% { transform: translate(0, 0); }
    12% { transform: translate(-7%, 4%); }
    25% { transform: translate(5%, -9%); }
    37% { transform: translate(-11%, -3%); }
    50% { transform: translate(9%, 8%); }
    62% { transform: translate(-3%, 11%); }
    75% { transform: translate(12%, -5%); }
    87% { transform: translate(-6%, -12%); }
    100% { transform: translate(0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .grain {
      animation: none;
    }
  }
  .bg-overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay);
  }
</style>
