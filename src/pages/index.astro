---
import Base from "../layouts/Base.astro";
import Release from "../components/Release.astro";
import Newsletter from "../components/Newsletter.astro";
import Links from "../components/Links.astro";
import Credit from "../components/Credit.astro";
import { site } from "../site";
---

<Base>
  <Links title="Follow" links={site.socials} />
  <Release />
  <Links title="Listen" links={site.streaming} />
  <Newsletter />
  <Links title="Contact" links={site.contact} variant="text" />
  <Credit />
</Base>
