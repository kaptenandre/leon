---
import Base from "../layouts/Base.astro";
import Release from "../components/Release.astro";
import Newsletter from "../components/Newsletter.astro";
import Links from "../components/Links.astro";
import Credit from "../components/Credit.astro";
import Dropdown from "../components/Dropdown.astro";
import { site } from "../site";
---

<Base>
  <nav aria-label="Follow and listen" class="nav">
    <Dropdown label="Follow" links={site.socials} />
    <Release />
  </nav>
  <Newsletter />
  <Links title="Contact" links={site.contact} variant="text" />
  <Credit />
</Base>
