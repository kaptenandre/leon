# Mailchimp (Account > Extras > API keys). The data center (e.g. us21) is read from the key suffix.
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Audience > Settings > Audience name and defaults > Audience ID
MAILCHIMP_AUDIENCE_ID=
# "true" sends a confirmation email first (status "pending"). Default: subscribe directly.
MAILCHIMP_DOUBLE_OPTIN=false
# "true" also opts the phone number into Mailchimp SMS (requires an active SMS program).
MAILCHIMP_SMS=false
# Merge field tag that stores the phone number (Audience > Settings > Audience fields).
MAILCHIMP_PHONE_FIELD=PHONE
# Merge field tag that stores the visitor's country code (ISO, e.g. SE).
MAILCHIMP_COUNTRY_FIELD=COUNTRY
# Comma separated tags added to every signup.
MAILCHIMP_TAGS=Hemsida
